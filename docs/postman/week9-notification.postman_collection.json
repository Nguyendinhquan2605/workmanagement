          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('w9Suffix', suffix);",
              "pm.collectionVariables.set('w9ManagerUsername', `manager_w9_${suffix}`);",
              "pm.collectionVariables.set('w9Manager2Username', `manager2_w9_${suffix}`);",
              "pm.collectionVariables.set('w9Member1Username', `member1_w9_${suffix}`);",
              "pm.collectionVariables.set('w9Member2Username', `member2_w9_${suffix}`);",
              "pm.collectionVariables.set('w9InactiveUsername', `inactive_w9_${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('w9AdminToken', pm.response.json().accessToken);",
              "pm.test('ADMIN token saved', () => pm.expect(pm.collectionVariables.get('w9AdminToken')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
