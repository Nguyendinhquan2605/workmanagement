    { "key": "message1Id", "value": "" },
    { "key": "message2Id", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const auth = pm.request.auth;",
          "if (auth && auth.type === 'bearer') {",
          "  const tokenEntry = auth.bearer.find(item => item.key === 'token');",
          "  const tokenRef = tokenEntry && tokenEntry.value;",
          "  const match = typeof tokenRef === 'string' ? tokenRef.match(/^\\{\\{(.+)\\}\\}$/) : null;",
          "  const token = match ? pm.collectionVariables.get(match[1]) : tokenRef;",
          "  if (token) {",
          "    pm.request.auth = { type: 'bearer', bearer: [{ key: 'token', value: token, type: 'string' }] };",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
