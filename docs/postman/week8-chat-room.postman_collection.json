              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('runSuffix', suffix);",
              "pm.collectionVariables.set('managerUsername', `manager_w8_${suffix}`);",
              "pm.collectionVariables.set('manager2Username', `manager2_w8_${suffix}`);",
              "pm.collectionVariables.set('member1Username', `member1_w8_${suffix}`);",
              "pm.collectionVariables.set('member2Username', `member2_w8_${suffix}`);",
              "pm.collectionVariables.set('inactiveUsername', `inactive_w8_${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);",
              "pm.test('ADMIN token saved', () => pm.expect(pm.collectionVariables.get('adminToken')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
