          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('runSuffix', suffix);",
              "pm.collectionVariables.set('managerUsername', `manager_w7_${suffix}`);",
              "pm.collectionVariables.set('manager2Username', `manager2_w7_${suffix}`);",
